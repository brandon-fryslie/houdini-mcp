# Houdini RPC Server connection. HOUDINI_HOST is the machine running Houdini as the
# container reaches it (localhost is the container itself); compose refuses it empty.
HOUDINI_HOST=
HOUDINI_PORT=18811

# MCP Server configuration
# The address on this machine the server answers at (0.0.0.0: every interface)
# MCP_HOST=127.0.0.1
MCP_PORT=3055
# Comma-separated names or addresses a client may call the server by, beyond loopback
# MCP_ALLOWED_HOSTS=

# AI summarization: on by default against the local omlx server over OpenAI chat completions
# SUMMARIZATION_ENABLED=true
# SUMMARIZATION_BASE_URL=http://100.66.66.66:8000/v1
# SUMMARIZATION_API_KEY=1234
# SUMMARIZATION_MODEL=mlx-community--Qwen3-30B-A3B-Instruct-2507-8bit
